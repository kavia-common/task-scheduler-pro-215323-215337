# Backend environment variables required for Task Scheduler Pro

# Database configuration (prefer POSTGRES_URL if available)
# Example format:
# postgresql+psycopg://appuser:dbuser123@localhost:5000/myapp
POSTGRES_URL=
#
# Alternatively (if the platform provides split connection vars), set:
# POSTGRES_USER=
# POSTGRES_PASSWORD=
# POSTGRES_DB=
# POSTGRES_PORT=
# Optional:
# POSTGRES_HOST=localhost

# JWT signing secret (set to a long random value in production)
JWT_SECRET_KEY=

# Optional overrides
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# CORS
# "*" (default) or a comma-separated list:
# http://localhost:3000,https://your-frontend.example.com
CORS_ALLOW_ORIGINS=*
#
# Convenience: single origin to allow (useful for platform preview URL, e.g. https://...:3000)
FRONTEND_URL=
